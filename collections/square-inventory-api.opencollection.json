        {
          "info": {
            "name": "Square Retrieve Inventory Count",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://connect.squareup.com/v2/inventory/:catalog_object_id",
            "params": [
              {
                "name": "catalog_object_id",
