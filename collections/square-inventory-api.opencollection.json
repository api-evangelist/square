                "type": "path",
                "description": "ID of the [CatalogObject](entity:CatalogObject) to retrieve."
              },
              {
                "name": "location_ids",
                "value": "",
                "type": "query",
                "description": "The [Location](entity:Location) IDs to look up as a comma-separated\nlist. An empty list queries all locations."
